# ============================================================
# Backstage Server Deployment - b14.openledger.vn
# Server: 172.20.2.41 | Gateway: 172.20.2.16 (103.67.184.32)
#
# HƯỚNG DẪN:
#   cp .env.example .env
#   Chỉnh sửa .env với giá trị thực
#   make up
# ============================================================

# ------ Backstage Image ------
# Docker image name:tag sau khi build và push/load lên server
BACKSTAGE_IMAGE=backstage:latest

# ------ URL truy cập ------
# URL công khai mà người dùng dùng để truy cập Backstage
APP_BASE_URL=https://b14.openledger.vn

# ------ PostgreSQL ------
POSTGRES_USER=backstage
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# ------ Structurizr On-Premise ------
# Public URL để browser truy cập Structurizr trực tiếp
# Port 8080 phải được forward từ gateway 172.20.2.16 → 172.20.2.41:8080
STRUCTURIZR_PUBLIC_URL=http://b14.openledger.vn:8080

# Workspace ID (tìm trong Structurizr sau khi tạo workspace)
STRUCTURIZR_WORKSPACE_ID=1

# API Key và Secret của Structurizr workspace
STRUCTURIZR_API_KEY=CHANGE_ME_API_KEY
STRUCTURIZR_API_SECRET=CHANGE_ME_API_SECRET

# ------ GitHub OAuth (bỏ qua nếu không dùng) ------
AUTH_GITHUB_CLIENT_ID=disabled
AUTH_GITHUB_CLIENT_SECRET=disabled

# ------ Google OAuth (bỏ qua nếu không dùng) ------
AUTH_GOOGLE_CLIENT_ID=disabled
AUTH_GOOGLE_CLIENT_SECRET=disabled
