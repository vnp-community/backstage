# ============================================================
# Backstage Seed Scripts — Environment Configuration
#
# Sao chép file này thành .env và điền giá trị thực:
#   cp .env.example .env
# ============================================================

# ------ Backstage Server ------
# URL của Backstage backend (không có trailing slash)
BACKSTAGE_BASE_URL=https://b14.openledger.vn

# ------ Authentication ------
# Token để xác thực với Backstage API.
# Cách 1: Dùng Backstage guest token (chỉ khi guest auth được bật)
# Cách 2: Dùng static token được cấu hình trong app-config.yaml (backend.auth.keys)
# Cách 3: Để trống nếu dangerouslyDisableDefaultAuthPolicy: true
BACKSTAGE_TOKEN=

# ------ Seed Configuration ------
# Namespace mặc định cho các entities (thường là "default")
DEFAULT_NAMESPACE=default

# Số lần retry khi gặp lỗi kết nối
MAX_RETRIES=3

# Delay (giây) giữa các requests để tránh rate limiting
REQUEST_DELAY=0.2

# Timeout (giây) cho mỗi HTTP request
REQUEST_TIMEOUT=30

# ------ Logging ------
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Ghi log ra file (để trống để chỉ log ra console)
LOG_FILE=

# ------ Data Paths ------
# Đường dẫn đến thư mục chứa seed data (mặc định: ../data)
DATA_DIR=../data
